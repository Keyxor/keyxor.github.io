public/
resources/_gen/
.hugo_build.lock

# Raw, unredacted screenshots. Captures are staged outside the repo
# (~/website-in-progress/screenshots-raw) and enter it only through
# scripts/add-screenshot.sh, which strips metadata on the way in.
_raw/
*.raw.*
screenshots-raw/

# Windows alternate-data-stream sidecars. WSL surfaces these as real files when
# something is copied in from a Windows download, and Hugo then publishes them
# out of static/ alongside the file they describe.
*:Zone.Identifier
